use std::{
    error::Error,
    sync::{Arc, Mutex},
    thread,
};

use pixels::{Pixels, SurfaceTexture};
use termion::event;
use winit::{
    application::ApplicationHandler,
    dpi::LogicalSize,
    event::WindowEvent,
    event_loop::{ActiveEventLoop, EventLoop},
    platform::wayland::EventLoopBuilderExtWayland,
    window::Window,
};

use crate::{
    device::DeviceMessage,
    host_device::{GpuMessage, GpuOperation, HostDevice},
    memory::DIRTY_PAGE_SIZE,
    native::NativeHostReciever,
};

type Result<T> = std::result::Result<T, Box<dyn Error>>;

const WIDTH: u32 = 800;
const HEIHGT: u32 = 600;

const BUFFER_SIZE: u32 = WIDTH * HEIHGT;

#[derive(Debug)]
pub struct HostGpu {
    frame_buffer: Arc<Mutex<Vec<u8>>>,
    resource_id: u32,
    gpu_rx: NativeHostReciever,
}

struct App<'a> {
    window: Option<Arc<Window>>,
    pixels: Option<Pixels<'a>>,
    frame_buffer: Arc<Mutex<Vec<u8>>>,
}

impl HostDevice for HostGpu {
    fn run(self: Box<Self>) {
        HostGpu::run(*self).unwrap();
    }
}

impl<'a> ApplicationHandler<GpuMessage> for App<'a> {
    fn resumed(&mut self, event_loop: &ActiveEventLoop) {
        if self.window.is_none() {
            let size = LogicalSize::new(WIDTH, HEIHGT);
            let window_attrs = Window::default_attributes()
                .with_title("RISC-V Emulator Display")
                .with_inner_size(size);

            let window = Arc::new(event_loop.create_window(window_attrs).unwrap());

            let surface_texture = SurfaceTexture::new(WIDTH, HEIHGT, Arc::clone(&window));

            let pixels = Pixels::new(WIDTH, HEIHGT, surface_texture).expect("Pixels error");

            self.window = Some(window);
            self.pixels = Some(pixels);

            self.window.as_ref().unwrap().request_redraw();
        }
    }

    fn user_event(&mut self, event_loop: &ActiveEventLoop, event: GpuMessage) {
        match event.operation {
            GpuOperation::Flush => {
                self.window.as_ref().unwrap().request_redraw();
            }
            GpuOperation::Copy(dirty_bits) => {
                let pixels = self.pixels.as_mut().unwrap();

                let frame = pixels.frame_mut();
                let lock = self.frame_buffer.lock().unwrap();

                for (i, &v) in dirty_bits.iter().enumerate() {
                    if v == 0 {
                        continue;
                    }

                    for shift in 0..32 {
                        let bit = 1 << shift;

                        if v & bit != 0 {
                            let start = i * DIRTY_PAGE_SIZE * 32 + shift * DIRTY_PAGE_SIZE;

                            let mut end = start + DIRTY_PAGE_SIZE;

                            if start >= frame.len() {
                                continue;
                            }

                            if end > frame.len() {
                                end = frame.len();
                            }

                            let frame = &mut frame[start..end];
                            let lock = &lock[start..end];

                            frame
                                .chunks_exact_mut(4)
                                .zip(lock.chunks_exact(4))
                                .for_each(|(dst, src)| {
                                    dst[0] = src[2]; // R
                                    dst[1] = src[1]; // G
                                    dst[2] = src[0]; // B
                                    dst[3] = 0xff; // A
                                });
                        }
                    }
                }
            }
            _ => {}
        }
    }

    fn window_event(
        &mut self,
        event_loop: &ActiveEventLoop,
        _id: winit::window::WindowId,
        event: WindowEvent,
    ) {
        match event {
            WindowEvent::CloseRequested => {
                event_loop.exit();
            }
            WindowEvent::RedrawRequested => {
                if let Some(pixels) = self.pixels.as_mut() {
                    if let Err(e) = pixels.render() {
                        eprintln!("pixels.render() failed: {}", e);
                        event_loop.exit();
                    }
                }
            }
            _ => (),
        }
    }
}

impl HostGpu {
    pub fn new(frame_buffer: Arc<Mutex<Vec<u8>>>, gpu_rx: NativeHostReciever) -> Self {
        HostGpu {
            frame_buffer,
            resource_id: 0,
            gpu_rx,
        }
    }

    pub fn run(mut self) -> Result<()> {
        let mut event_builder = EventLoop::<GpuMessage>::with_user_event();

        event_builder.with_any_thread(true);

        let event_loop = event_builder.build()?;

        let mut app = App {
            window: None,
            pixels: None,
            frame_buffer: self.frame_buffer.clone(),
        };

        let proxy = event_loop.create_proxy();
        let rx = self.gpu_rx;

        thread::spawn(move || {
            loop {
                if let Ok(DeviceMessage::Gpu(message)) = rx.recv() {
                    proxy.send_event(message).unwrap();
                }
            }
        });

        event_loop.run_app(&mut app)?;

        Ok(())
    }
}
